      <bpmndi:BPMNEdge id="Edge_flow_s_gr_n_post_gr" bpmnElement="flow_s_gr_n_post_gr"><di:waypoint x="96" y="120" /><di:waypoint x="290" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_n_post_gr_n_inspect" bpmnElement="flow_n_post_gr_n_inspect"><di:waypoint x="450" y="120" /><di:waypoint x="520" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_n_inspect_g_qc" bpmnElement="flow_n_inspect_g_qc"><di:waypoint x="680" y="120" /><di:waypoint x="750" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_g_qc_n_putaway" bpmnElement="flow_g_qc_n_putaway"><di:waypoint x="800" y="120" /><di:waypoint x="980" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_g_qc_n_return" bpmnElement="flow_g_qc_n_return"><di:waypoint x="800" y="120" /><di:waypoint x="830" y="120" /><di:waypoint x="830" y="240" /><di:waypoint x="980" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_n_putaway_e_gr_done" bpmnElement="flow_n_putaway_e_gr_done"><di:waypoint x="1140" y="120" /><di:waypoint x="1210" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_n_return_e_gr_done" bpmnElement="flow_n_return_e_gr_done"><di:waypoint x="1140" y="240" /><di:waypoint x="1170" y="240" /><di:waypoint x="1170" y="120" /><di:waypoint x="1210" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
    <bpmndi:BPMNPlane id="Plane_invoice_verification" bpmnElement="invoice_verification">
      <bpmndi:BPMNShape id="Shape_e_inv_done" bpmnElement="e_inv_done"><dc:Bounds x="1670" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_g_match" bpmnElement="g_match"><dc:Bounds x="750" y="95" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_n_appr_inv" bpmnElement="n_appr_inv"><dc:Bounds x="980" y="200" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_n_clear" bpmnElement="n_clear"><dc:Bounds x="1440" y="80" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_n_enter_inv" bpmnElement="n_enter_inv"><dc:Bounds x="290" y="80" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_n_handle_exc" bpmnElement="n_handle_exc"><dc:Bounds x="1210" y="80" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_n_match" bpmnElement="n_match"><dc:Bounds x="520" y="80" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_n_park" bpmnElement="n_park"><dc:Bounds x="980" y="80" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_n_pay" bpmnElement="n_pay"><dc:Bounds x="1210" y="200" width="160" height="80" /></bpmndi:BPMNShape>
