      <bpmndi:BPMNEdge id="Edge_flow_s_po_n_create_po" bpmnElement="flow_s_po_n_create_po"><di:waypoint x="96" y="120" /><di:waypoint x="290" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_n_create_po_g_amount" bpmnElement="flow_n_create_po_g_amount"><di:waypoint x="450" y="120" /><di:waypoint x="520" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_g_amount_n_dir_appr" bpmnElement="flow_g_amount_n_dir_appr"><di:waypoint x="570" y="120" /><di:waypoint x="750" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_g_amount_n_send_po" bpmnElement="flow_g_amount_n_send_po"><di:waypoint x="570" y="120" /><di:waypoint x="600" y="120" /><di:waypoint x="600" y="240" /><di:waypoint x="750" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_n_dir_appr_g_dir_result" bpmnElement="flow_n_dir_appr_g_dir_result"><di:waypoint x="910" y="120" /><di:waypoint x="980" y="120" /></bpmndi:BPMNEdge>
