    <bpmndi:BPMNPlane id="Plane_goods_receipt" bpmnElement="goods_receipt">
      <bpmndi:BPMNShape id="Shape_e_gr_done" bpmnElement="e_gr_done"><dc:Bounds x="1210" y="102" width="36" height="36" /></bpmndi:BPMNShape>
