      <bpmndi:BPMNEdge id="Edge_flow_g_dir_result_n_revise_po" bpmnElement="flow_g_dir_result_n_revise_po"><di:waypoint x="1030" y="120" /><di:waypoint x="1210" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_g_dir_result_n_cancel_po" bpmnElement="flow_g_dir_result_n_cancel_po"><di:waypoint x="1030" y="120" /><di:waypoint x="1060" y="120" /><di:waypoint x="1060" y="240" /><di:waypoint x="1210" y="240" /></bpmndi:BPMNEdge>
