      <bpmndi:BPMNShape id="Shape_n_revise" bpmnElement="n_revise"><dc:Bounds x="1210" y="80" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_n_submit" bpmnElement="n_submit"><dc:Bounds x="290" y="80" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_s_req" bpmnElement="s_req"><dc:Bounds x="60" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_flow_s_req_n_submit" bpmnElement="flow_s_req_n_submit"><di:waypoint x="96" y="120" /><di:waypoint x="290" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_n_submit_g_need_appr" bpmnElement="flow_n_submit_g_need_appr"><di:waypoint x="450" y="120" /><di:waypoint x="520" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_g_need_appr_n_mgr_appr" bpmnElement="flow_g_need_appr_n_mgr_appr"><di:waypoint x="570" y="120" /><di:waypoint x="750" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_g_need_appr_n_convert" bpmnElement="flow_g_need_appr_n_convert"><di:waypoint x="570" y="120" /><di:waypoint x="600" y="120" /><di:waypoint x="600" y="240" /><di:waypoint x="750" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_n_mgr_appr_g_appr_result" bpmnElement="flow_n_mgr_appr_g_appr_result"><di:waypoint x="910" y="120" /><di:waypoint x="980" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_g_appr_result_n_convert" bpmnElement="flow_g_appr_result_n_convert"><di:waypoint x="1005" y="145" /><di:waypoint x="1005" y="340" /><di:waypoint x="830" y="340" /><di:waypoint x="830" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_g_appr_result_n_revise" bpmnElement="flow_g_appr_result_n_revise"><di:waypoint x="1030" y="120" /><di:waypoint x="1210" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_g_appr_result_n_cancel" bpmnElement="flow_g_appr_result_n_cancel"><di:waypoint x="1030" y="120" /><di:waypoint x="1060" y="120" /><di:waypoint x="1060" y="240" /><di:waypoint x="1210" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_n_revise_n_submit" bpmnElement="flow_n_revise_n_submit"><di:waypoint x="1290" y="160" /><di:waypoint x="1290" y="340" /><di:waypoint x="370" y="340" /><di:waypoint x="370" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_n_convert_e_req_done" bpmnElement="flow_n_convert_e_req_done"><di:waypoint x="910" y="240" /><di:waypoint x="980" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_n_cancel_e_req_drop" bpmnElement="flow_n_cancel_e_req_drop"><di:waypoint x="1370" y="240" /><di:waypoint x="1400" y="240" /><di:waypoint x="1400" y="120" /><di:waypoint x="1440" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
    <bpmndi:BPMNPlane id="Plane_purchase_order" bpmnElement="purchase_order">
      <bpmndi:BPMNShape id="Shape_e_po_done" bpmnElement="e_po_done"><dc:Bounds x="980" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_e_po_drop" bpmnElement="e_po_drop"><dc:Bounds x="1440" y="102" width="36" height="36" /></bpmndi:BPMNShape>
