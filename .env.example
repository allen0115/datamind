# LLM 配置模板 —— 复制为 .env 后填入真实值(.env 已被 .gitignore 排除)
#
# 只影响 LLM × pm4py 组合分析能力;不配置时全部走规则化降级,
# pm4py 的分析与报告生成完全不受影响。
#
# 环境变量优先级高于 config.yaml,方便切换模型而不改配置。

# --------------------------------------------------------------------------
# DeepSeek(默认示例):OpenAI 兼容协议,支持 response_format=json_object
#
#   base_url(OpenAI SDK) https://api.deepseek.com
#   base_url(Anthropic)  https://api.deepseek.com/anthropic
#
# 模型名(官方建议使用 deepseek-flash):
#   deepseek-flash      推荐;旧名 deepseek-v4-flash / deepseek-v4-flash-vision-exp
#                       仍可调用,但已下线,实际由 DeepSeek-V4.1-Flash 提供服务
#                       并按 Flash 价格计费
#   deepseek-v4-pro
# --------------------------------------------------------------------------
DATAMIND_LLM_ENABLED=true
DATAMIND_LLM_MODEL=deepseek-flash
DATAMIND_LLM_BASE_URL=https://api.deepseek.com
DATAMIND_LLM_API_KEY=sk-在这里填你的DeepSeekKey

# --------------------------------------------------------------------------
# 其他 OpenAI 兼容服务(把上面四行换成对应值即可)
# --------------------------------------------------------------------------
# —— 官方 OpenAI
# DATAMIND_LLM_MODEL=gpt-4o-mini
# DATAMIND_LLM_BASE_URL=
# DATAMIND_LLM_API_KEY=sk-...
#
# —— 通义千问(兼容模式)
# DATAMIND_LLM_MODEL=qwen-plus
# DATAMIND_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DATAMIND_LLM_API_KEY=sk-...
#
# —— 本地 vLLM / Ollama(OpenAI 兼容端口)
# DATAMIND_LLM_MODEL=qwen2.5:7b
# DATAMIND_LLM_BASE_URL=http://localhost:11434/v1
# DATAMIND_LLM_API_KEY=ollama

# 可选:调用超时(秒)与输出不合法时的重试次数
# DATAMIND_LLM_TIMEOUT_S=30
# DATAMIND_LLM_MAX_RETRIES=1
